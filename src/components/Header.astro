---
import { sitio, navEnlaces, navCta } from '../lib/contenido';
import { ruta } from '../config';

const actual = Astro.url.pathname.replace(/\/$/, '');

const esActiva = (destino: string) => {
  if (destino.includes('#')) return false;
  const rutaLimpia = destino.replace(/\/$/, '');
  return actual === rutaLimpia || actual.startsWith(rutaLimpia + '/');
};
---

<header class="cabecera">
  <div class="contenedor cabecera__in">
    <a class="marca" href={ruta('/')} aria-label={`${sitio.nombre} — inicio`}>
      <span class="marca__sigla" aria-hidden="true">{sitio.marcaSigla}</span>
      <span class="marca__txt">
        <span class="marca__nombre">{sitio.marca}</span>
        <span class="marca__rol">{sitio.marcaRol}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      {navEnlaces.map((enlace) => {
        const destino = ruta(`/${enlace.href}`);
        return (
          <a
            class="nav__enlace"
            href={destino}
            aria-current={esActiva(destino) ? 'page' : undefined}
          >
            {enlace.texto}
          </a>
        );
      })}
    </nav>

    <a class="btn btn--lleno cabecera__cta" href={ruta(`/${navCta.href}`)}>
      {navCta.texto} <span class="btn__flecha" aria-hidden="true">→</span>
    </a>

    <span class="cabecera__rev" title="Versión del borrador">{sitio.revision}</span>
  </div>
  <span class="cabecera__progreso" data-progreso aria-hidden="true"></span>
</header>
