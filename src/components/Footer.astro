---
import { footer as pie, t } from '../lib/contenido';
import { ruta } from '../config';

const destino = (href: string) => {
  if (href.startsWith('#')) return ruta(`/${href}`);
  return ruta(href);
};
---

<footer class="pie">
  <div class="contenedor pie__in">
    <div class="rotulo" aria-label="Rótulo del plano">
      {pie.rotulo.map((celda) => (
        <div class="rotulo__celda">
          <span class="rotulo__k">{celda.etiqueta}</span>
          <span class="rotulo__v">{t(celda.valor)}</span>
        </div>
      ))}
    </div>

    <div class="pie__abajo">
      <nav class="pie__nav" aria-label="Navegación del pie">
        {pie.nav.map((enlace) => (
          <a href={destino(enlace.href)}>{enlace.texto}</a>
        ))}
      </nav>
      <p class="pie__legal">{t(pie.legal)}</p>
    </div>
  </div>
</footer>
