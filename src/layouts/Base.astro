---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitio, ruta } from '../config';

interface Props {
  titulo?: string;
  descripcion?: string;
  ogTipo?: string;
}

const {
  titulo,
  descripcion = 'Portafolio BIM: digitalización de planos 2D a modelos Revit.',
  ogTipo = 'website',
} = Astro.props;
const tituloPagina = titulo
  ? `${titulo} — ${sitio.nombre}`
  : `${sitio.nombre} — Portafolio BIM`;
const canonica = new URL(Astro.url.pathname, Astro.site ?? 'https://rivas.ing');

const ficha = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: sitio.nombre,
  jobTitle: 'Ingeniero civil',
  description: descripcion,
  email: `mailto:${sitio.email}`,
  url: canonica.origin,
  address: { '@type': 'PostalAddress', addressLocality: sitio.ciudad },
  knowsAbout: ['Ingeniería estructural', 'Modelado BIM', 'Dirección de obra'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    <meta name="theme-color" content="#f3f0e8" />

    <meta property="og:type" content={ogTipo} />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:locale" content="es_VE" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ficha)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="sr-only" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Aparición progresiva de bloques */
      const bloques = document.querySelectorAll('.revelar');
      if (!('IntersectionObserver' in window) || menosMovimiento) {
        bloques.forEach((el) => el.classList.add('visible'));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('visible');
                observador.unobserve(entrada.target);
              }
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        bloques.forEach((el) => observador.observe(el));
      }

      /* Paralaje suave de la figura isométrica */
      const figura = document.querySelector('[data-paralaje]');
      const iso = figura?.querySelector('.iso');
      if (figura && iso && !menosMovimiento && window.matchMedia('(pointer: fine)').matches) {
        let cuadro = 0;
        figura.addEventListener('pointermove', (evento) => {
          cancelAnimationFrame(cuadro);
          cuadro = requestAnimationFrame(() => {
            const caja = figura.getBoundingClientRect();
            const x = (evento.clientX - caja.left) / caja.width - 0.5;
            const y = (evento.clientY - caja.top) / caja.height - 0.5;
            iso.style.transform = `translate(${(-x * 12).toFixed(1)}px, ${(-y * 9).toFixed(1)}px)`;
          });
        });
        figura.addEventListener('pointerleave', () => {
          iso.style.transform = '';
        });
      }

      /* Índice de proyectos: la vista previa sigue a la fila activa */
      const indice = document.querySelector('[data-indice]');
      const vista = document.querySelector('[data-vista]');
      if (indice && vista) {
        const cubiertas = vista.querySelectorAll('[data-cubierta]');
        const pie = vista.querySelector('[data-vista-pie]');
        const activar = (indiceFila: string) => {
          cubiertas.forEach((cubierta) => {
            cubierta.dataset.activa = String(cubierta.dataset.cubierta === indiceFila);
          });
          const fila = indice.querySelector(`[data-fila="${indiceFila}"]`);
          if (pie && fila) pie.textContent = fila.dataset.leyenda ?? '';
        };
        indice.querySelectorAll('[data-fila]').forEach((fila) => {
          fila.addEventListener('mouseenter', () => activar(fila.dataset.fila));
          fila.addEventListener('focus', () => activar(fila.dataset.fila));
        });
        activar('0');
      }

      /* Navegación interna: desplazamiento animado con compensación de cabecera */
      const raiz = document.documentElement;
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cabecera = document.querySelector('.cabecera');
      const progreso = document.querySelector('[data-progreso]');
      let animacion = 0;
      let comportamientoPrevio: string | null = null;

      const restaurarComportamiento = () => {
        if (comportamientoPrevio === null) return;
        raiz.style.scrollBehavior = comportamientoPrevio;
        comportamientoPrevio = null;
      };

      const cancelarDesplazamiento = () => {
        animacion += 1;
        restaurarComportamiento();
      };
      ['wheel', 'touchstart'].forEach((evento) =>
        window.addEventListener(evento, cancelarDesplazamiento, { passive: true }),
      );

      const desplazarA = (destinoY: number) => {
        const inicio = window.scrollY;
        const distancia = destinoY - inicio;
        if (Math.abs(distancia) < 2) return;

        const id = ++animacion;
        if (comportamientoPrevio === null) {
          comportamientoPrevio = raiz.style.scrollBehavior;
          raiz.style.scrollBehavior = 'auto';
        }

        /* Con “reducir movimiento” se mantiene un desplazamiento breve, no un salto. */
        const duracion = reducido ? 220 : Math.min(950, 420 + Math.abs(distancia) * 0.12);
        const arranque = performance.now();
        const ease = reducido
          ? (t: number) => t
          : (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

        const paso = (ahora: number) => {
          if (id !== animacion) return;
          const t = Math.min((ahora - arranque) / duracion, 1);
          window.scrollTo(0, inicio + distancia * ease(t));
          if (t < 1) requestAnimationFrame(paso);
          else restaurarComportamiento();
        };
        requestAnimationFrame(paso);
      };

      document.addEventListener('click', (evento) => {
        const objetivo = evento.target;
        if (!(objetivo instanceof Element)) return;
        const enlace = objetivo.closest('a[href]');
        if (!enlace) return;

        const url = new URL(enlace.getAttribute('href') ?? '', location.href);
        if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) {
          return;
        }

        const destino = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (!destino) return;

        evento.preventDefault();
        const altoCabecera = cabecera?.clientHeight ?? 0;
        const y = destino.getBoundingClientRect().top + window.scrollY - altoCabecera - 14;
        desplazarA(Math.max(0, y));
        history.pushState(null, '', url.hash);

        if (!destino.hasAttribute('tabindex')) destino.setAttribute('tabindex', '-1');
        destino.focus({ preventScroll: true });
        destino.addEventListener('blur', () => destino.removeAttribute('tabindex'), { once: true });
      });

      /* Barra de progreso de lectura */
      if (progreso) {
        let pendiente = false;
        const pintarProgreso = () => {
          const maximo = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = maximo > 0 ? Math.min(Math.max(window.scrollY / maximo, 0), 1) : 0;
          (progreso as HTMLElement).style.transform = `scaleX(${ratio})`;
          pendiente = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (pendiente) return;
            pendiente = true;
            requestAnimationFrame(pintarProgreso);
          },
          { passive: true },
        );
        pintarProgreso();
      }

      /* Enlace activo según la sección visible */
      const enlacesNav = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__enlace'));
      if (enlacesNav.length && 'IntersectionObserver' in window) {
        const porSeccion = new Map<Element, HTMLAnchorElement>();
        enlacesNav.forEach((enlace) => {
          const id = new URL(enlace.href).hash.slice(1);
          const seccion = document.getElementById(id);
          if (seccion) porSeccion.set(seccion, enlace);
        });

        const observadorNav = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (!entrada.isIntersecting) return;
              enlacesNav.forEach((enlace) => enlace.classList.remove('nav__enlace--activo'));
              porSeccion.get(entrada.target)?.classList.add('nav__enlace--activo');
            });
          },
          { rootMargin: '-35% 0px -55% 0px', threshold: 0 },
        );
        porSeccion.forEach((_, seccion) => observadorNav.observe(seccion));
      }
    </script>
  </body>
</html>
