---
import Base from '../layouts/Base.astro';
import Hoja from '../components/Hoja.astro';
import Estructura from '../components/Estructura.astro';
import Visor3D from '../components/Visor3D.astro';
import { ruta } from '../config';
import {
  contenido,
  seccion,
  t,
  perfil,
  servicios,
  modelos,
  herramientas,
  trayectoria,
  contacto,
} from '../lib/contenido';

const hero = contenido.hero;
const cifras = contenido.cifras;
const proyectos = modelos.items;
const herramientasTexto = contenido.contenido.herramientas;
const publicados = String(proyectos.length).padStart(2, '0');

const visible = (id: string) => Boolean(seccion(id)?.visible);
const meta = (id: string) => t(seccion(id)?.meta ?? '');
const titulo = (id: string) => seccion(id)?.nombre ?? '';

const destino = (href: string) => (href.startsWith('#') ? href : ruta(href));
---

<Base>
  <section class="contenedor hero">
    <div class="hero__txt">
      <div class="hero__eyebrow">
        <span class="eti">{t(hero.eyebrow)}</span>
      </div>

      {/* El título admite <em>; el contenido lo edita el administrador. */}
      <h1 class="hero__h1" set:html={t(hero.titulo)} />

      <p class="hero__p">{t(hero.parrafo)}</p>

      <div class="hero__acciones">
        <a class="btn btn--lleno" href={destino(hero.boton.href)}>
          {hero.boton.texto} <span class="btn__flecha" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero__fig revelar" style="--d:.15s">
      <figure class="figura" data-paralaje>
        <div class="figura__lienzo">
          <Estructura />
        </div>
        <figcaption class="figura__pie">
          <span class="eti">{t(hero.figura.etiqueta)}</span>
          <span class="eti">{t(hero.figura.pie)}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="contenedor">
    <div class="cifras">
      {cifras.map((cifra) => (
        <div class="cifra">
          <span class="cifra__n">{t(cifra.valor)}</span>
          <span class="cifra__l">{t(cifra.etiqueta)}</span>
        </div>
      ))}
    </div>
  </div>

  {visible('perfil') && (
    <section class="seccion contenedor" id="perfil">
      <Hoja num={seccion('perfil')?.numero ?? ''} titulo={titulo('perfil')} meta={meta('perfil')} />

      <div class="perfil perfil--bio">
        <div class="perfil__bio revelar">
          {perfil.parrafos.map((parrafo) => (
            <p>{t(parrafo)}</p>
          ))}

          <div class="datos">
            {perfil.datos.map((dato) => (
              <div class="dato">
                <dt>{dato.etiqueta}</dt>
                <dd>
                  {t(dato.valor)}
                  {dato.enlace && (
                    <a
                      class="dato__cert"
                      href={t(dato.enlace.href)}
                      target="_blank"
                      rel="noopener"
                    >
                      {t(dato.enlace.texto)}
                    </a>
                  )}
                </dd>
              </div>
            ))}
          </div>
        </div>

        <div class="retrato revelar" style="--d:.08s">
          {perfil.foto ? (
            <img
              class="retrato__img"
              src={ruta(`/${perfil.foto}`)}
              alt={perfil.fotoAlt}
              loading="lazy"
            />
          ) : (
            <div class="retrato__texto">
              <span class="eti">{perfil.fotoPie}</span>
              <p class="eti" style="margin-top:10px; opacity:.7">{perfil.fotoPendiente}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {visible('servicios') && (
    <section class="seccion contenedor" id="servicios">
      <Hoja
        num={seccion('servicios')?.numero ?? ''}
        titulo={titulo('servicios')}
        meta={meta('servicios')}
      />

      <div class="especialidades">
        {servicios.map((servicio, i) => (
          <article class="especialidad revelar" style={`--d:${(i * 0.07).toFixed(2)}s`}>
            {servicio.icono && (
              <img
                class="especialidad__icono"
                src={ruta(`/${servicio.icono}`)}
                alt=""
                loading="lazy"
              />
            )}
            <h3 class="especialidad__t">{servicio.titulo}</h3>
            <p class="especialidad__d">{t(servicio.detalle)}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {visible('proyectos') && (
    <section class="seccion contenedor" id="proyectos">
      <Hoja
        num={seccion('proyectos')?.numero ?? ''}
        titulo={titulo('proyectos')}
        meta={meta('proyectos')}
      />

      <div class="indice" data-indice>
        <div class="filas">
          {proyectos.map((proyecto, i) => (
            <button
              class="fila revelar"
              type="button"
              data-modelo={proyecto.archivo}
              data-peso={proyecto.peso}
              data-titulo={proyecto.titulo}
              data-nota={proyecto.nota}
              data-vista={proyecto.vistaInicial ? JSON.stringify(proyecto.vistaInicial) : undefined}
              aria-pressed={i === 0 ? 'true' : 'false'}
              style={`--d:${(i * 0.06).toFixed(2)}s`}
            >
              <span class="fila__cuerpo">
                <span class="fila__tit">{proyecto.titulo}</span>
                <span class="fila__sub">{t(proyecto.subtitulo)}</span>
              </span>
              <span class="fila__meta">
                {proyecto.superficie && (
                  <>
                    <span class="fila__cap">Superficie modelada</span>
                    <span class="fila__sup">{proyecto.superficie}</span>
                  </>
                )}
                <span class="fila__lin">{t(proyecto.meta)}</span>
              </span>
            </button>
          ))}
        </div>

        {proyectos.length > 0 && (
          <aside class="indice__visor">
            <Visor3D
              titulo={proyectos[0].titulo}
              archivo={proyectos[0].archivo}
              peso={proyectos[0].peso}
              nota={proyectos[0].nota}
              vista={proyectos[0].vistaInicial}
              compacto
            />
          </aside>
        )}
      </div>

      <p class="nota-autoria nota-autoria--ancha">
        <span class="eti eti--senal">Sobre estos modelos</span>
        <span>{t(modelos.nota)}</span>
      </p>
    </section>
  )}

  {visible('herramientas') && (
    <section class="seccion contenedor" id="herramientas">
      <Hoja
        num={seccion('herramientas')?.numero ?? ''}
        titulo={titulo('herramientas')}
        meta={meta('herramientas')}
      />

      <div class="herramientas">
        <div class="herramientas__intro">
          <p class="herramientas__lead">{t(herramientasTexto.entrada)}</p>
          <p class="herramientas__nota">{t(herramientasTexto.nota)}</p>
        </div>

        <ul class="herramientas__grid">
          {herramientas.map((software, indice) => (
            <li class="herramienta revelar" style={`--d:${indice * 0.07}s`}>
              <div class="herramienta__cab">
                <h3 class="herramienta__nombre">{software.nombre}</h3>
                <img
                  class="herramienta__icono"
                  src={ruta(`/${software.icono}`)}
                  alt=""
                  width="64"
                  height="64"
                  loading="lazy"
                />
              </div>
              <p class="herramienta__nivel">
                <span>{software.nivelUso}</span>
                <span class="herramienta__anios">{software.años} años</span>
              </p>
              <p class="herramienta__contexto">{t(software.contexto)}</p>
              {software.tags?.length > 0 && (
                <ul class="herramienta__tags" aria-label={`Especialidades de ${software.nombre}`}>
                  {software.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {visible('trayectoria') && (
    <section class="seccion contenedor" id="trayectoria">
      <Hoja
        num={seccion('trayectoria')?.numero ?? ''}
        titulo={titulo('trayectoria')}
        meta={meta('trayectoria')}
      />

      <div class="trayectoria">
        <div>
          <h3 class="trayectoria__t eti">Experiencia</h3>
          <div class="linea-tiempo">
            {trayectoria.experiencia.map((hito) => (
              <div class="hito revelar">
                <span class="hito__fecha">{hito.periodo}</span>
                <div>
                  <h4 class="hito__t">{hito.cargo}</h4>
                  <p class="hito__d">{t(hito.detalle)}</p>
                </div>
                <span class="hito__lugar">{hito.lugar}</span>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="trayectoria__t eti">Formación y cursos</h3>

          <a
            class="certificado"
            href={t(trayectoria.certificado.href)}
            target="_blank"
            rel="noopener"
          >
            <span class="certificado__eti">{trayectoria.certificado.etiqueta}</span>
            <span class="certificado__t">{t(trayectoria.certificado.titulo)}</span>
            <span class="certificado__c">{trayectoria.certificado.texto}</span>
          </a>

          <div class="cursos">
            {trayectoria.formacion.map((curso) => (
              <div class="curso revelar">
                <span class="curso__a">{curso.año}</span>
                <div>
                  <h4 class="curso__t">{curso.titulo}</h4>
                  <p class="curso__d">{t(curso.detalle)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {visible('contacto') && (
    <section class="seccion contenedor" id="contacto">
      <Hoja
        num={seccion('contacto')?.numero ?? ''}
        titulo={titulo('contacto')}
        meta={meta('contacto')}
      />

      <div class="contacto-grid">
        <div class="revelar">
          <h2 class="contacto__tit" set:html={t(contacto.pregunta)} />
          <p class="contacto__p">{t(contacto.parrafo)}</p>
        </div>

        <aside class="revelar" style="--d:.08s">
          <h2 class="eti" style="margin-bottom:18px">Canales directos</h2>
          <div class="canales">
            {contacto.canales.map((canal) =>
              canal.href ? (
                <a class="canal" href={t(canal.href)} target="_blank" rel="noopener">
                  <span class="canal__k">{t(canal.etiqueta)}</span>
                  <span class="canal__v">{t(canal.valor)}</span>
                </a>
              ) : (
                <div class="canal">
                  <span class="canal__k">{t(canal.etiqueta)}</span>
                  <span class="canal__v">{t(canal.valor)}</span>
                </div>
              ),
            )}
          </div>

          <p class="aviso" style="margin-top:22px">{t(contacto.aviso)}</p>
        </aside>
      </div>
    </section>
  )}

  <script>
    const visor = document.querySelector('[data-visor]');
    const filas = document.querySelectorAll('[data-modelo]');

    filas.forEach((fila) => {
      fila.addEventListener('click', () => {
        filas.forEach((otra) => otra.setAttribute('aria-pressed', String(otra === fila)));

        const api = visor?.visorAPI;
        let vista;
        try {
          vista = fila.dataset.vista ? JSON.parse(fila.dataset.vista) : undefined;
        } catch {
          vista = undefined;
        }
        api?.cargar({
          archivo: fila.dataset.modelo,
          peso: fila.dataset.peso,
          titulo: fila.dataset.titulo,
          nota: fila.dataset.nota,
          vista,
        });

        if (window.matchMedia('(max-width: 1080px)').matches) {
          visor?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  </script>
</Base>
