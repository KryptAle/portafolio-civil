---
import Base from '../layouts/Base.astro';
import Hoja from '../components/Hoja.astro';
import Estructura from '../components/Estructura.astro';
import ProyectoCover from '../components/ProyectoCover.astro';
import { sitio, ruta } from '../config';
import { experiencia, formacion } from '../data/trayectoria';
import proyectos from '../data/proyectos.json';

const cifras = [
  { n: '04', l: 'Modelos publicados' },
  { n: '300–350', l: 'Nivel de desarrollo' },
  { n: 'Revit', l: 'Herramienta principal' },
  { n: 'Caracas', l: 'Base de trabajo' },
];

const servicios = [
  {
    t: 'Digitalización 2D a 3D',
    d: 'Reconstruyo plantas, cortes y detalles en PDF o imagen dentro de Revit, con ejes y niveles como esqueleto.',
  },
  {
    t: 'Modelado arquitectónico',
    d: 'Muros, losas, cubiertas, carpinterías y familias propias para puertas y ventanas.',
  },
  {
    t: 'Modelado estructural',
    d: 'Columnas, vigas, losas y armaduras, con parámetros que permiten verificar el despiece.',
  },
  {
    t: 'Documentación y vistas',
    d: 'Láminas, tablas de planificación, recorridos y detección de interferencias.',
  },
];

const software = [
  { nombre: 'Revit', nivel: 'Avanzado', anios: 4, pct: 92 },
  { nombre: 'AutoCAD', nivel: 'Avanzado', anios: 6, pct: 90 },
  { nombre: 'Navisworks', nivel: 'Intermedio', anios: 3, pct: 72 },
  { nombre: 'Enscape', nivel: 'Intermedio', anios: 2, pct: 68 },
  { nombre: 'Advance Steel', nivel: 'Básico', anios: 1, pct: 48 },
  { nombre: 'Excel / Python', nivel: 'Intermedio', anios: 4, pct: 66 },
];
---

<Base>
  <section class="contenedor hero">
    <div class="hero__txt">
      <div class="hero__eyebrow">
        <span class="eti">BIM · Revit · Digitalización 2D → 3D</span>
      </div>

      <h1 class="hero__h1">
        Planos en 2D, <span class="em">modelos</span> que se recorren.
      </h1>

      <p class="hero__p">
        Soy ingeniero civil y digitalizo planos. Reconstruyo documentación en PDF o imagen
        dentro de Revit: ejes, niveles, estructura, cerramientos y familias coordinadas para
        que el modelo se pueda medir, revisar y recorrer.
      </p>

      <div class="hero__acciones">
        <a class="btn btn--lleno" href="#proyectos">
          Ver modelos <span class="btn__flecha" aria-hidden="true">→</span>
        </a>
        <a class="btn" href="#contacto">
          Hablemos <span class="btn__flecha" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="hero__fig revelar" style="--d:.15s">
      <figure class="figura" data-paralaje>
        <div class="figura__lienzo">
          <Estructura />
        </div>
        <figcaption class="figura__pie">
          <span class="eti">Fig. 01 — Axonométrica</span>
          <span class="eti">8 niveles · 25,60 m</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="contenedor">
    <div class="cifras">
      {cifras.map((c) => (
        <div class="cifra">
          <span class="cifra__n">{c.n}</span>
          <span class="cifra__l">{c.l}</span>
        </div>
      ))}
    </div>
  </div>

  <section class="seccion contenedor" id="perfil">
    <Hoja num="01" titulo="Perfil" meta="Quién firma · L-02" />

    <div class="perfil perfil--bio">
      <div class="perfil__bio revelar">
        <p>
          Soy ingeniero civil y trabajo digitalizando planos. Tomo documentación 2D —PDF,
          escaneos, imágenes— y la reconstruyo en Revit: ejes, niveles, muros, losas,
          estructura y familias. El objetivo no es solo que el modelo se vea bien, sino que sea
          medible, navegable y consistente.
        </p>
        <p>
          Los proyectos de este portafolio son ejercicios de modelado: el diseño original es de
          sus autores y los planos son de referencia pública. Lo que es mío es el modelo —la
          interpretación, la geometría y el criterio con que se construyó—, y lo dejo claro en
          cada ficha.
        </p>
        <p>
          También leo planos estructurales y puedo coordinar disciplinas, generar vistas,
          láminas y recorridos. Me interesa el detalle que hace que un modelo sirva para
          construir, no solo para presentar.
        </p>

        <div class="datos">
          <div class="dato">
            <dt>Formación</dt>
            <dd>Ingeniero civil</dd>
          </div>
          <div class="dato">
            <dt>Base</dt>
            <dd>{sitio.ciudad}</dd>
          </div>
          <div class="dato">
            <dt>Idiomas</dt>
            <dd>Español · Inglés B2</dd>
          </div>
          <div class="dato">
            <dt>Disponibilidad</dt>
            <dd>Proyectos remotos</dd>
          </div>
        </div>
      </div>

      <div class="retrato revelar" style="--d:.08s">
        <div class="retrato__texto">
          <span class="eti">Retrato · 4:5</span>
          <p class="eti" style="margin-top:10px; opacity:.7">Fotografía pendiente</p>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion contenedor">
    <Hoja num="02" titulo="Qué hago" meta="Servicios · L-03" />

    <div class="especialidades">
      {servicios.map((s, i) => (
        <article class="especialidad revelar" style={`--d:${(i * 0.07).toFixed(2)}s`}>
          <span class="especialidad__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="especialidad__t">{s.t}</h3>
          <p class="especialidad__d">{s.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="seccion contenedor" id="proyectos">
    <Hoja num="03" titulo="Modelos BIM" meta="Ejercicios de digitalización · 04" />

    <div class="indice" data-indice>
      <div class="filas">
        {proyectos.map((p, i) => (
          <a
            class="fila revelar"
            href={ruta(`/proyectos/${p.slug}`)}
            data-fila={String(i)}
            data-leyenda={`${p.titulo} · ${p.lod}`}
            style={`--d:${(i * 0.06).toFixed(2)}s`}
          >
            <div class="fila__num">{p.indice}</div>
            <div class="fila__cuerpo">
              <span class="fila__tit">{p.titulo}</span>
              <span class="fila__sub">{p.subtitulo}</span>
              <div class="fila__fig">
                <ProyectoCover tipo={p.tipo} indice={p.indice} titulo={p.titulo} />
              </div>
            </div>
            <div class="fila__meta">
              {p.disciplina}
              <br />
              {p.lod} · {p.anio}
            </div>
            <span class="fila__flecha" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>

      <aside class="vista" data-vista aria-hidden="true">
        {proyectos.map((p, i) => (
          <div
            class="vista__item"
            data-cubierta={String(i)}
            data-activa={i === 0 ? 'true' : 'false'}
          >
            <ProyectoCover tipo={p.tipo} indice={p.indice} titulo={p.titulo} />
          </div>
        ))}
        <div class="vista__pie">
          <span class="eti eti--claro">Vista previa</span>
          <span class="eti eti--claro" data-vista-pie>
            {proyectos[0].titulo} · LOD 300
          </span>
        </div>
      </aside>
    </div>

    <p class="nota-autoria nota-autoria--ancha">
      <span class="eti eti--senal">Sobre estos modelos</span>
      <span>
        El diseño original y los planos de referencia pertenecen a sus autores. El modelo 3D,
        la interpretación y la documentación son de mi autoría: son ejercicios de
        digitalización para demostrar manejo de Revit, no obras diseñadas por mí.
      </span>
    </p>

    <div style="margin-top:32px">
      <a class="btn" href={ruta('/proyectos')}>
        Ver el índice completo <span class="btn__flecha" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="seccion contenedor">
    <Hoja num="04" titulo="Herramientas" meta="Nivel de uso · L-04" />

    <table class="tabla-software">
      <thead>
        <tr>
          <th scope="col">Herramienta</th>
          <th scope="col">Nivel</th>
          <th scope="col" style="text-align:right">Años</th>
        </tr>
      </thead>
      <tbody>
        {software.map((s) => (
          <tr>
            <td>{s.nombre}</td>
            <td>
              <div class="nivel">
                <div class="nivel__barra">
                  <span class={s.nivel === 'Avanzado' ? 'es-alto' : ''} style={`width:${s.pct}%`} />
                </div>
                <span class="nivel__txt">{s.nivel}</span>
              </div>
            </td>
            <td style="text-align:right; font-family:var(--mono); font-size:12px">{s.anios}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="seccion contenedor" id="trayectoria">
    <Hoja num="05" titulo="Trayectoria" meta="Experiencia y formación · L-05" />

    <div class="trayectoria">
      <div>
        <h3 class="trayectoria__t eti">Experiencia</h3>
        <div class="linea-tiempo">
          {experiencia.map((h) => (
            <div class="hito revelar">
              <span class="hito__fecha">{h.periodo}</span>
              <div>
                <h4 class="hito__t">{h.cargo}</h4>
                <p class="hito__d">{h.detalle}</p>
              </div>
              <span class="hito__lugar">{h.lugar}</span>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="trayectoria__t eti">Formación y cursos</h3>
        <div class="cursos">
          {formacion.map((c) => (
            <div class="curso revelar">
              <span class="curso__a">{c.anio}</span>
              <div>
                <h4 class="curso__t">{c.titulo}</h4>
                <p class="curso__d">{c.detalle}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion contenedor" id="contacto">
    <Hoja num="06" titulo="Contacto" meta="Proyectos y consultas · L-06" />

    <div class="contacto-grid">
      <div class="revelar">
        <h2 class="contacto__tit">
          ¿Tienes planos que<br /><span class="em">necesitas en 3D?</span>
        </h2>
        <p class="contacto__p">
          Cuéntame qué documentación tienes y qué nivel de detalle necesitas. Respondo con una
          primera lectura del alcance y un plazo estimado.
        </p>
      </div>

      <aside class="revelar" style="--d:.08s">
        <h2 class="eti" style="margin-bottom:18px">Canales directos</h2>
        <div class="canales">
          <a class="canal" href={`mailto:${sitio.email}`}>
            <span class="canal__k">Correo</span>
            <span class="canal__v">{sitio.email}</span>
          </a>
          <a class="canal" href={`https://wa.me/${sitio.whatsapp}`} rel="noopener">
            <span class="canal__k">WhatsApp</span>
            <span class="canal__v">Escribir mensaje ↗</span>
          </a>
          <a class="canal" href={sitio.linkedin} rel="noopener">
            <span class="canal__k">LinkedIn</span>
            <span class="canal__v">/in/alejandroaguilera ↗</span>
          </a>
          <div class="canal">
            <span class="canal__k">Ubicación</span>
            <span class="canal__v">{sitio.ciudad}</span>
          </div>
        </div>

        <p class="aviso" style="margin-top:22px">
          Si ya tienes los planos, adjunta una muestra en el primer mensaje. Los archivos se
          comparten después por enlace seguro.
        </p>
      </aside>
    </div>
  </section>
</Base>
