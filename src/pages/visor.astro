---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Vista 3D · Administración</title>
    <style>
      :root {
        --fondo: #10151a;
        --papel: #f3f0e8;
        --senal: #c23a1f;
        --mono: ui-monospace, 'Cascadia Mono', Consolas, monospace;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; overflow: hidden; background: var(--fondo); }
      #visor { position: fixed; inset: 0; }

      .barra {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        background: linear-gradient(transparent, rgba(16, 21, 26, 0.9));
        color: var(--papel);
        pointer-events: none;
      }

      .barra p {
        margin: 0;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        line-height: 1.5;
        opacity: 0.8;
      }

      .estado {
        position: fixed;
        inset: 0;
        z-index: 6;
        display: grid;
        place-items: center;
        padding: 24px;
        background: rgba(16, 21, 26, 0.88);
        color: var(--papel);
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-align: center;
      }

      .estado[hidden] { display: none; }
    </style>
  </head>
  <body>
    <div id="visor"></div>
    <div id="estado" class="estado">Cargando modelo 3D…</div>
    <div class="barra">
      <p>Arrastra para orbitar · rueda o pinza para acercar · vuelve al panel para guardar la vista</p>
    </div>

    <script>
      import { iniciarVisor } from '../lib/visor3d';

      const contenedor = document.getElementById('visor');
      const estado = document.getElementById('estado');
      const params = new URLSearchParams(location.search);
      const ruta = params.get('archivo') ?? '';
      const peso = Number(params.get('peso')) || undefined;
      const base = baseUrl();

      let vista;
      try {
        vista = params.get('vista') ? JSON.parse(params.get('vista')!) : undefined;
      } catch {
        vista = undefined;
      }

      function baseUrl() {
        return document.documentElement.dataset.base ?? '/';
      }

      const mostrarEstado = (texto: string) => {
        if (!estado) return;
        estado.hidden = !texto;
        if (texto) estado.textContent = texto;
      };

      if (!ruta) {
        mostrarEstado('Falta el archivo del modelo.');
      } else {
        try {
          const api = await iniciarVisor({
            contenedor: contenedor!,
            archivo: `${base}${ruta}`,
            base,
            peso,
            vista,
            onEstado: mostrarEstado,
          });

          mostrarEstado('');
          window.parent.postMessage({ tipo: 'visor-listo' }, location.origin);

          window.addEventListener('message', (evento) => {
            if (evento.source !== window.parent || evento.origin !== location.origin) return;
            if (evento.data?.tipo === 'pedir-vista') {
              window.parent.postMessage({ tipo: 'vista', vista: api.obtenerVista() }, location.origin);
            }
            if (evento.data?.tipo === 'aplicar-vista' && evento.data.vista) {
              api.aplicarVista(evento.data.vista);
            }
          });
        } catch (error) {
          console.error(error);
          mostrarEstado('No se pudo cargar el modelo 3D.');
        }
      }
    </script>
  </body>
</html>
