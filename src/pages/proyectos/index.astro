---
import Base from '../../layouts/Base.astro';
import ProyectoCover from '../../components/ProyectoCover.astro';
import { ruta } from '../../config';
import proyectos from '../../data/proyectos.json';

const categorias = ['Todos', ...Array.from(new Set(proyectos.map((p) => p.categoria)))];
---

<Base
  titulo="Modelos BIM"
  descripcion="Ejercicios de digitalización BIM: planos 2D de referencia reconstruidos en Revit. Fichas con alcance, nivel de desarrollo y criterio de modelado."
>
  <section class="contenedor encabezado-pagina">
    <nav class="miga" aria-label="Ruta">
      <a href={ruta('/')}>Inicio</a>
      <span aria-hidden="true">/</span>
      <span>Modelos</span>
    </nav>

    <div class="proy__cab">
      <div>
        <h1 class="proy__tit">Índice de<br />modelos</h1>
        <p class="proy__sub">
          Cuatro ejercicios de digitalización: planos 2D de referencia reconstruidos en Revit.
          Cada ficha explica el reto de interpretación, el criterio de modelado y el resultado.
        </p>
      </div>

      <div>
        <dl class="proy__meta">
          <div>
            <dt>Modelos publicados</dt>
            <dd>04</dd>
          </div>
          <div>
            <dt>Niveles</dt>
            <dd>LOD 300 — 350</dd>
          </div>
          <div>
            <dt>Disciplinas</dt>
            <dd>Arquitectura · Estructura · Metálica · Hidráulica</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="contenedor seccion seccion--ajustada">
    <div class="filtros" role="group" aria-label="Filtrar por disciplina">
      {
        categorias.map((c) => (
          <button
            class="filtro"
            type="button"
            data-filtro={c.toLowerCase()}
            aria-pressed={c === 'Todos' ? 'true' : 'false'}
          >
            {c}
          </button>
        ))
      }
      <span class="filtros__cuenta eti">
        <span data-cuenta>04</span> modelos
      </span>
    </div>

    <div class="rejilla-proyectos">
      {
        proyectos.map((p, i) => (
          <a
            class="tarjeta revelar"
            href={ruta(`/proyectos/${p.slug}`)}
            data-tarjeta
            data-disciplina={p.categoria.toLowerCase()}
            style={`--d:${(i * 0.06).toFixed(2)}s`}
          >
            <div class="tarjeta__fig">
              <ProyectoCover tipo={p.tipo} indice={p.indice} titulo={p.titulo} />
            </div>
            <div class="tarjeta__pie">
              <div>
                <span class="eti">
                  {p.indice} · {p.disciplina} · {p.lod}
                </span>
                <h2 class="tarjeta__t">{p.titulo}</h2>
                <p class="tarjeta__sub">{p.subtitulo}</p>
              </div>
              <span class="eti tarjeta__anio">{p.anio}</span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="nota-autoria nota-autoria--ancha">
      <span class="eti eti--senal">Sobre estos modelos</span>
      <span>
        El diseño original y los planos de referencia pertenecen a sus autores. El modelo 3D y
        su documentación son de mi autoría: son ejercicios de digitalización para demostrar
        manejo de Revit, no obras diseñadas por mí.
      </span>
    </p>
  </section>

  <script>
    const botones = document.querySelectorAll('[data-filtro]');
    const tarjetas = document.querySelectorAll('[data-tarjeta]');
    const cuenta = document.querySelector('[data-cuenta]');

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const filtro = boton.dataset.filtro ?? 'todos';
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));

        let visibles = 0;
        tarjetas.forEach((tarjeta) => {
          const coincide =
            filtro === 'todos' || (tarjeta.dataset.disciplina ?? '').includes(filtro);
          tarjeta.hidden = !coincide;
          if (coincide) visibles++;
        });

        if (cuenta) cuenta.textContent = String(visibles).padStart(2, '0');
      });
    });
  </script>
</Base>
