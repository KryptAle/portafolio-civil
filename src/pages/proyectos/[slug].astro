---
import Base from '../../layouts/Base.astro';
import ProyectoCover from '../../components/ProyectoCover.astro';
import Plano from '../../components/Plano.astro';
import { ruta, sitio } from '../../config';
import proyectos from '../../data/proyectos.json';

export function getStaticPaths() {
  return proyectos.map((proyecto, i) => ({
    params: { slug: proyecto.slug },
    props: { proyecto, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { proyecto, siguiente } = Astro.props;
const p = proyecto;

const ficha = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.titulo,
  description: p.resumen,
  dateCreated: String(p.anio),
  creator: { '@type': 'Person', name: sitio.nombre },
  about: `Modelado BIM — ${p.disciplina}`,
};
---

<Base
  titulo={p.titulo}
  descripcion={`${p.titulo} — ${p.subtitulo}. Ejercicio de digitalización BIM en Revit.`}
  ogTipo="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(ficha)} />

  <article>
    <header class="contenedor encabezado-pagina">
      <nav class="miga" aria-label="Ruta">
        <a href={ruta('/')}>Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={ruta('/proyectos')}>Proyectos</a>
        <span aria-hidden="true">/</span>
        <span>{p.titulo}</span>
      </nav>

      <div class="proy__cab">
        <div>
          <span class="eti eti--senal">Modelo {p.indice} · {p.disciplina}</span>
          <h1 class="proy__tit" style="margin-top:14px">{p.titulo}</h1>
          <p class="proy__sub">{p.subtitulo}</p>
        </div>

        <dl class="proy__meta">
          <div>
            <dt>Año</dt>
            <dd>{p.anio}</dd>
          </div>
          <div>
            <dt>Alcance</dt>
            <dd>{p.alcance}</dd>
          </div>
          <div>
            <dt>Nivel de desarrollo</dt>
            <dd>{p.lod}</dd>
          </div>
          <div>
            <dt>Horas de modelado</dt>
            <dd>{p.horas}</dd>
          </div>
          <div>
            <dt>Fuente</dt>
            <dd>{p.fuente}</dd>
          </div>
        </dl>
      </div>

      <div class="proy__portada revelar">
        <ProyectoCover tipo={p.tipo} indice={p.indice} titulo={p.titulo} />
      </div>
    </header>

    <div class="contenedor">
      <div class="metricas">
        {p.metricas.map((m) => (
          <div class="metrica">
            <span class="metrica__v">{m.valor}</span>
            <span class="metrica__e">{m.etiqueta}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="contenedor proy__cuerpo">
      <div>
        <p class="proy__resumen">{p.resumen}</p>

        <div class="nota-autoria">
          <span class="eti eti--senal">Sobre la autoría</span>
          <p>
            El modelo 3D es de mi autoría. El diseño original y los planos de referencia
            pertenecen a sus autores: se usaron únicamente como ejercicio de digitalización y
            modelado BIM. Este proyecto no incluye {p.noIncluye.toLowerCase()}.
          </p>
        </div>

        <div class="bloques">
          <div class="bloque">
            <h2 class="bloque__t">El reto</h2>
            <p class="bloque__p">{p.reto}</p>
          </div>
          <div class="bloque">
            <h2 class="bloque__t">Criterio de modelado</h2>
            <p class="bloque__p">{p.criterio}</p>
          </div>
          <div class="bloque">
            <h2 class="bloque__t">Resultado</h2>
            <p class="bloque__p">{p.resultado}</p>
          </div>
        </div>

        <p class="aviso">
          Láminas ilustrativas generadas para este borrador. En la versión final se sustituyen
          por capturas del modelo real en Revit.
        </p>
      </div>

      <aside class="tecnica">
        <div class="tecnica__grupo">
          <h2 class="tecnica__t">Criterios y estándar</h2>
          <ul>
            {p.estandares.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        </div>

        <div class="tecnica__grupo">
          <h2 class="tecnica__t">Software</h2>
          <ul>
            {p.software.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>

        <div class="tecnica__grupo">
          <h2 class="tecnica__t">Entregables</h2>
          <ul>
            {p.entregables.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        </div>

        {p.solicitarArchivos && (
          <div class="tecnica__grupo">
            <a
              class="btn btn--lleno"
              href={`mailto:${sitio.email}?subject=${encodeURIComponent(
                `Solicitud de modelo — ${p.titulo}`,
              )}&body=${encodeURIComponent(
                `Hola, me interesa el modelo «${p.titulo}». Quisiera coordinar una revisión y solicitar el archivo RVT.`,
              )}`}
              style="width:100%; justify-content:center"
            >
              Solicitar modelo RVT <span class="btn__flecha" aria-hidden="true">→</span>
            </a>
            <p class="eti" style="margin-top:10px">
              Archivo .rvt disponible bajo solicitud.
            </p>
          </div>
        )}
      </aside>
    </div>

    <div class="contenedor">
      <div class="galeria">
        <figure class="lamina lamina--ancha revelar">
          <div class="lamina__lienzo">
            <Plano variante="planta" etiqueta={`${p.indice} · N+9,60`} />
          </div>
          <figcaption class="lamina__pie">
            <span class="eti">Planta tipo</span>
            <span class="eti">Esc. 1:100</span>
          </figcaption>
        </figure>

        <figure class="lamina revelar">
          <div class="lamina__lienzo">
            <Plano variante="corte" etiqueta={`${p.indice} · A-A`} />
          </div>
          <figcaption class="lamina__pie">
            <span class="eti">Corte transversal</span>
            <span class="eti">Esc. 1:100</span>
          </figcaption>
        </figure>

        <figure class="lamina revelar">
          <div class="lamina__lienzo">
            <Plano variante="detalle" etiqueta="V-04" />
          </div>
          <figcaption class="lamina__pie">
            <span class="eti">Detalle de refuerzo</span>
            <span class="eti">Esc. 1:20</span>
          </figcaption>
        </figure>
      </div>

      <a class="siguiente" href={ruta(`/proyectos/${siguiente.slug}`)}>
        <div>
          <span class="eti">Siguiente modelo · {siguiente.indice}</span>
          <p class="siguiente__t">{siguiente.titulo}</p>
        </div>
        <span class="siguiente__flecha" aria-hidden="true">→</span>
      </a>
    </div>
  </article>
</Base>
