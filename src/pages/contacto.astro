---
import { ruta } from '../config';
const destino = `${ruta('/')}#contacto`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={destino} />
    <meta name="robots" content="noindex" />
    <title>Contacto — Alejandro Aguilera</title>
  </head>
  <body>
    <p>El contacto ahora está en la página principal. <a href={destino}>Continuar</a>.</p>
  </body>
</html>
